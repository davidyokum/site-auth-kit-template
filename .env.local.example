# Local development settings. Copy to .env.local (git-ignored; never commit it, and never copy it
# into Amplify's environment variables: ALLOW_DEV_SIGNIN must never exist on a deployed branch).

# The AWS profile the dev server uses for your SANDBOX pool and tables (Cognito checks, the People
# page, tickets, the audit log). Same profile as deploy.config.json.
AWS_PROFILE=personal

# Optional: your sandbox's AWS account ID. "Sign in as…" then refuses a pool in any other account.
AUTH_KIT_AWS_ACCOUNT=

# The third gate for "Sign in as…" (with NODE_ENV=development and a *.localhost host).
ALLOW_DEV_SIGNIN=1

# `npm run personas:seed` appends each persona's password and authenticator secret here
# (PERSONA_PASSWORD_<KEY>, PERSONA_TOTP_<KEY>). Never typed by hand, never printed, never real
# people's credentials: personas are throwaway sandbox accounts on .test addresses.
