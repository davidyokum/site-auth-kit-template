# Dependencies
node_modules/

# Next.js (.next-matrix: the auth-matrix tests' own dev server output)
.next/
.next-matrix/
out/
next-env.d.ts
*.tsbuildinfo

# Environment files: never commit any of them. The one exception is the example.
.env*
!.env.local.example

# Amplify Gen 2: generated by `npx ampx sandbox` (local) and by the branch pipeline (Amplify Hosting).
# Each environment writes its own; committing one would point every clone at that pool.
# CI copies ci/amplify_outputs.placeholder.json (clearly fake) here before building.
amplify_outputs*.json
!ci/amplify_outputs.placeholder.json
.amplify/

# The backdrop picker's backup of the previous site.config.ts (npm run backdrop:pick, backdrop:lock)
site.config.ts.bak
site.config.ts.writing

# Test and tool output
coverage/
.vitest/
*.log

# OS and editors
.DS_Store
.idea/
.vscode/
