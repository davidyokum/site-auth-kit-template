{
  "_comment": "PLACEHOLDER. Not a real user pool: every ID below is fake and nothing can sign in with it. CI copies this file to amplify_outputs.json so `next build`, the type checks, and the auth-matrix tests run without AWS. On your machine, `npm run sandbox` writes the real file (git-ignored); on Amplify Hosting the branch pipeline writes it during the build. See README, 'amplify_outputs.json'.",
  "version": "1.4",
  "auth": {
    "aws_region": "us-east-1",
    "user_pool_id": "us-east-1_PlaceholderPool",
    "user_pool_client_id": "placeholderappclient00000",
    "identity_pool_id": "us-east-1:00000000-0000-4000-8000-000000000000",
    "mfa_methods": ["TOTP"],
    "standard_required_attributes": ["email"],
    "username_attributes": ["email"],
    "user_verification_types": ["email"],
    "groups": [{ "owner": { "precedence": 0 } }, { "superadmin": { "precedence": 1 } }, { "admin-content-people": { "precedence": 2 } }, { "admin-content": { "precedence": 3 } }, { "admin-view": { "precedence": 4 } }],
    "mfa_configuration": "OPTIONAL",
    "password_policy": {
      "min_length": 15,
      "require_lowercase": false,
      "require_numbers": false,
      "require_symbols": false,
      "require_uppercase": false
    },
    "unauthenticated_identities_enabled": false,
    "passwordless": {
      "email_otp_enabled": true
    }
  }
}
